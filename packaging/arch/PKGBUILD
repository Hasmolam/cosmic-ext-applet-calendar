# Maintainer: Hasan Hüseyin Yolcu <hasanhuseyinyolcu25@gmail.com>
pkgname=cosmic-ext-applet-calendar-git
pkgver=1.0.0
pkgrel=1
pkgdesc="Standalone calendar and agenda applet for the COSMIC Desktop"
arch=('x86_64' 'aarch64')
url="https://github.com/Hasmolam/cosmic-ext-applet-calendar"
license=('GPL-3.0-only')
depends=('libxkbcommon' 'wayland' 'hicolor-icon-theme')
makedepends=('cargo' 'just' 'git')
provides=('cosmic-ext-applet-calendar')
conflicts=('cosmic-ext-applet-calendar')
source=("git+https://github.com/Hasmolam/cosmic-ext-applet-calendar.git")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname%-git}"
    just build
}

package() {
    cd "${srcdir}/${pkgname%-git}"
    just rootdir="${pkgdir}" prefix="/usr" install
}
